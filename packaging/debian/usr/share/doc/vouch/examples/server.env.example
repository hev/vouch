# Copy to /etc/vouch/server.env, owned by root with mode 0600, then:
#   systemctl enable --now vouch-server
NATS_URL=nats://127.0.0.1:4222
NATS_USER=vouch
NATS_PASS=change-me
VOUCH_STATE_PATH=/var/lib/vouch/state.sqlite3
VOUCH_LISTEN=127.0.0.1:8443
VOUCH_ORIGIN=https://sudo.example.com
VOUCH_RP_ID=sudo.example.com
