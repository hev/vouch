#!/usr/bin/env bash
# Wraps vouch-agent in an Vouch.app, unsigned by default.
#
# The Touch ID sheet takes its title and icon from the calling process's app
# bundle. A bare binary gets its file name and the generic executable badge; the
# bundle makes the sheet read "Vouch is trying to run ... on ...". The name
# and the icon do not need signing; the keychain entitlement does, so --sign
# applies scripts/mac/Vouch.entitlements when an identity is given.
#
# Rebuilds the bundle from scratch on every run.
set -euo pipefail

usage() {
  cat <<'USAGE'
usage: scripts/mac/bundle-agent [--binary PATH] [--output DIR] [--sign IDENTITY]
                               [--version VERSION]

  --binary PATH   agent binary to wrap (default: target/release/vouch-agent,
                  built with `cargo build --release -p vouch-agent` if absent)
  --output DIR    where Vouch.app is written (default: target/mac)
  --sign IDENTITY codesign identity, e.g. "Developer ID Application: ...".
                  Signs the bundle with the hardened runtime and the keychain
                  entitlement. Absent, the bundle stays unsigned.
  --version VER   version for CFBundleShortVersionString/CFBundleVersion
                  (default: the workspace version in the root Cargo.toml)

Prints the path of the binary inside the bundle, which is what the LaunchAgent
should run.
USAGE
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
BINARY=""
OUTPUT="$ROOT/target/mac"
SIGN=""
VERSION=""

while [ $# -gt 0 ]; do
  case "$1" in
    --binary) BINARY="${2:?--binary needs a path}"; shift 2 ;;
    --output) OUTPUT="${2:?--output needs a path}"; shift 2 ;;
    --sign) SIGN="${2:?--sign needs an identity}"; shift 2 ;;
    --version) VERSION="${2:?--version needs a value}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[ "$(uname -s)" = "Darwin" ] || { echo "bundle-agent only runs on macOS" >&2; exit 1; }

# A bundle whose version never moves is a bundle Launch Services and every
# crash report describe as 0.1.0 forever. The workspace version is the one
# the binary inside already reports, so read it from there by default rather
# than keeping a second number in sync by hand.
if [ -z "$VERSION" ]; then
  VERSION="$(sed -n '/^\[workspace\.package\]/,/^\[/s/^version = "\(.*\)"/\1/p' \
    "$ROOT/Cargo.toml" | head -1)"
fi
[ -n "$VERSION" ] || { echo "cannot read the workspace version from $ROOT/Cargo.toml" >&2; exit 1; }

if [ -z "$BINARY" ]; then
  BINARY="$ROOT/target/release/vouch-agent"
  if [ ! -x "$BINARY" ]; then
    ( cd "$ROOT" && cargo build --release -p vouch-agent )
  fi
fi
[ -x "$BINARY" ] || { echo "no agent binary at $BINARY" >&2; exit 1; }

APP="$OUTPUT/Vouch.app"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
install -m 0755 "$BINARY" "$APP/Contents/MacOS/vouch-agent"

# Unquoted delimiter on purpose: $VERSION below is the only expansion wanted
# and the rest of the document carries no $ or backtick of its own.
cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>dev.hev.vouch.agent</string>
  <key>CFBundleName</key><string>Vouch</string>
  <key>CFBundleDisplayName</key><string>Vouch</string>
  <key>CFBundleExecutable</key><string>vouch-agent</string>
  <key>CFBundleIconFile</key><string>Vouch</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$VERSION</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
PLIST

# The icon is what the sheet shows next to the name. assets/Vouch.icns is
# checked in, already scaled with nearest-neighbour from assets/vouch-1024.png
# (the icon is pixel art, and sips/iconutil would smooth it), so it is copied
# as is rather than rendered here.
icns="$APP/Contents/Resources/Vouch.icns"
if [ -f "$ROOT/assets/Vouch.icns" ]; then
  install -m 0644 "$ROOT/assets/Vouch.icns" "$icns"
else
  echo "note: no assets/Vouch.icns, so the sheet shows the name without the logo" >&2
fi

# Touch the bundle so Launch Services notices a rebuilt app at the same path.
touch "$APP"

if [ -n "$SIGN" ]; then
  # codesign leaves $(AppIdentifierPrefix) in the entitlements file
  # unexpanded, so the Team ID comes from the signing certificate's
  # Organizational Unit and the file is expanded before signing.
  team_id="$(security find-certificate -c "$SIGN" -p \
    | openssl x509 -noout -subject \
    | sed -n 's/.*OU *= *\([^,]*\).*/\1/p')"
  [ -n "$team_id" ] || { echo "cannot find a Team ID in the $SIGN certificate" >&2; exit 1; }
  entitlements="$(mktemp -t 'vouch-entitlements.XXXXXX').plist"
  # AppIdentifierPrefix carries its trailing dot by Apple convention; the
  # certificate field does not, so the replacement adds it.
  sed "s/\$(AppIdentifierPrefix)/$team_id./g" \
    "$ROOT/scripts/mac/Vouch.entitlements" > "$entitlements"
  # The binary first, then the bundle, so the bundle seal covers a signed
  # executable. --options runtime opts into the hardened runtime, which the
  # notarization lane requires; --timestamp keeps the signature verifiable
  # once the certificate expires.
  codesign --force --options runtime --timestamp \
    --entitlements "$entitlements" \
    --sign "$SIGN" "$APP/Contents/MacOS/vouch-agent" "$APP"
  rm -f "$entitlements"
  codesign --verify --strict --verbose=1 "$APP"
fi

echo "$APP/Contents/MacOS/vouch-agent"
