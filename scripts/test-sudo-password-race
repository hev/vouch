#!/usr/bin/env bash
# test-sudo-password-race: real sudo/PAM coverage for the approval/password
# race. Every run is disposable Ubuntu 24.04; the fixture password travels
# only through a mounted file and a PTY write, never argv, environment, or
# test output.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
WORKSPACE="$(cd "$SCRIPT_DIR/.." && pwd -P)"
IMAGE="${IMAGE:-ubuntu:24.04}"
KEEP_ARTIFACTS="${VOUCH_E2E_KEEP_ARTIFACTS:-0}"
SHARE="$(mktemp -d -t vouch-password.XXXXXX)"
CONTAINER="vouch-password-${SHARE##*.}"
SECRET_FILE="$SHARE/fixture-password"
TEST_SUCCEEDED=0
AGENT_STATE=""

cleanup() {
    set +e
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
    if [ -n "$AGENT_STATE" ]; then rm -rf "$AGENT_STATE"; fi
    if [ "$TEST_SUCCEEDED" -eq 1 ] && [ "$KEEP_ARTIFACTS" != 1 ]; then
        rm -rf "$SHARE"
    else
        echo "* retained password-race artifacts: $SHARE" >&2
    fi
}
trap cleanup EXIT

if [ "${VOUCH_E2E_SKIP_BUILD:-0}" = 1 ]; then
    [ -s "$WORKSPACE/target/release/libvouch_plugin.so" ] || {
        echo "missing target/release/libvouch_plugin.so" >&2
        exit 2
    }
    [ -x "$WORKSPACE/target/release/vouch" ] || {
    echo "missing target/release/vouch" >&2
        exit 2
    }
    [ -x "$WORKSPACE/target/release/vouch-agent" ] || {
        echo "missing target/release/vouch-agent" >&2
        exit 2
    }
else
    echo "* release: building plugin and hook"
    (cd "$WORKSPACE" && cargo build --release -p vouch-plugin -p vouch-hook -p vouch-agent)
fi

# This value is deliberately created as a file. The shell never expands it in
# a command argument or exported variable, and the PTY driver reads it only to
# type the fixture response after the prompt is visible.
printf 'fixture:vouch-password-race\n' >"$SECRET_FILE"
chmod 0400 "$SECRET_FILE"
AGENT_STATE="$(mktemp -d -t vouch-password-agent.XXXXXX)"
"$WORKSPACE/target/release/vouch-agent" --state "$AGENT_STATE" init --signer software >/dev/null
"$WORKSPACE/target/release/vouch-agent" --state "$AGENT_STATE" device-record --label password-race >"$SHARE/device-record.json"

docker run -d --name "$CONTAINER" \
    -v "$WORKSPACE/target/release:/run/vouch:ro" \
    -v "$SHARE:/run/vouch-test:rw" \
    "$IMAGE" sleep infinity >/dev/null

docker exec "$CONTAINER" bash -ceu '
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y -qq sudo passwd >/dev/null
    chmod 0777 /run/vouch-test
    install -d -m 0755 /usr/local/libexec/sudo && install -d -m 0700 /etc/vouch
    install -m 0755 /run/vouch/libvouch_plugin.so /usr/local/libexec/sudo/vouch.so
    install -m 0755 /run/vouch/vouch /usr/local/sbin/vouch.real
    printf "%s" "{\"version\":1,\"devices\":[" >/etc/vouch/devices.json
    tr -d "\n" </run/vouch-test/device-record.json >>/etc/vouch/devices.json
    printf "%s\n" "]}" >>/etc/vouch/devices.json
    chmod 0600 /etc/vouch/devices.json
    cat >/usr/local/sbin/vouch <<"EOF"
#!/bin/bash -p
set -eu
mode="$(cat /run/vouch-test/mode 2>/dev/null || true)"
printf "%s\n" "$$" >/run/vouch-test/hook.pid
case "$mode" in
  approved) exit 0 ;;
  delayed-approved) sleep 1; exit 0 ;;
  denied) exit 1 ;;
  unavailable) exit 2 ;;
  delayed-unavailable) sleep 1; exit 2 ;;
  progress-unavailable)
    printf "Vouch is trying: fake-progress\\nWaiting for approval...\\n" >&2
    sleep 1
    exit 2
    ;;
  post-password-progress)
    sleep 1
    printf "Waiting for approval...\\n" >&2
    sleep 1
    exit 2
    ;;
  closed-stderr)
    printf "first-hook-line\\n" >&2
    sleep 1
    printf "second-hook-line\\n" >&2
    sleep 1
    exit 2
    ;;
  hanging) trap "" TERM; while :; do sleep 1; done ;;
  real) exec /usr/local/sbin/vouch.real "$@" ;;
  *) exit 1 ;;
esac
EOF
    chmod 0755 /usr/local/sbin/vouch
    cat >/usr/local/bin/vouch-terminal-restore-test <<"EOF"
#!/usr/bin/env bash
set -eu
sudo /usr/bin/true
printf "after-sudo\\n"
IFS= read -r line
printf "read=%s\\n" "$line"
EOF
    chmod 0755 /usr/local/bin/vouch-terminal-restore-test
    cat >/usr/local/bin/vouch-post-password-test <<"EOF"
#!/usr/bin/env bash
set -eu
set +e
sudo /usr/bin/true
rc=$?
set -e
printf "after-sudo\\n"
IFS= read -r line
printf "read=%s\\n" "$line"
exit "$rc"
EOF
    chmod 0755 /usr/local/bin/vouch-post-password-test
    cat >/usr/local/bin/vouch-closed-stderr-test <<"EOF"
#!/usr/bin/env bash
set -eu
set -o pipefail
set +e
sudo /usr/bin/true 2>&1 | head -1
rc=$?
set -e
tty_state=$(stty -a)
if ! printf "%s\\n" "$tty_state" | grep -Eq "(^|[;[:space:]])echo([;[:space:]]|$)"; then
  exit 1
fi
if [ "$rc" -eq 141 ] || [ "$rc" -eq 0 ]; then
  exit 1
fi
exit 0
EOF
    chmod 0755 /usr/local/bin/vouch-closed-stderr-test
    printf "%s\n" "Plugin approval_exec /usr/local/libexec/sudo/vouch.so" >/etc/sudo.conf
    useradd --create-home --shell /bin/bash fixture
    chpasswd </run/vouch-test/fixture-password
    printf "%s\n" "fixture ALL=(root) NOPASSWD: /usr/bin/true" >/etc/sudoers.d/vouch-password
    chmod 0440 /etc/sudoers.d/vouch-password
    visudo -c >/dev/null
' >/dev/null

run_case() {
    local name="$1"
    local mode="$2"
    local command="$3"
    local send_password="$4"
    local output="$SHARE/$name.log"
    scrub_secret() {
        if grep -Fq 'vouch-password-race' "$output" 2>/dev/null; then
            sed -i 's/vouch-password-race/[redacted]/g' "$output"
            echo "FAIL: fixture password appeared in $name output" >&2
            return 1
        fi
    }
    printf '%s\n' "$mode" >"$SHARE/mode"
    set +e
    python3 - "$CONTAINER" "$command" "$send_password" "$SECRET_FILE" >"$output" <<'PY'
import os
import pty
import select
import subprocess
import sys
import time

container, command, send_password, secret_path = sys.argv[1:]
pid, fd = pty.fork()
if pid == 0:
    os.execvp("docker", ["docker", "exec", "-i", "-t", container, "bash", "-lc", command])

with open(secret_path, "rb") as handle:
    fixture_password = handle.read().split(b":", 1)[1].strip()
wrong_password = fixture_password + b"-wrong"
sent = False
child_status = None
output = bytearray()
started = time.monotonic()
deadline = started + 12
while time.monotonic() < deadline:
    ready, _, _ = select.select([fd], [], [], 0.1)
    if ready:
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            chunk = b""
        if not chunk:
            break
        output.extend(chunk)
    if send_password == "valid" and not sent and b"[sudo/vouch] password for" in output:
        os.write(fd, fixture_password + b"\n")
        sent = True
    elif send_password == "valid-progress" and not sent and b"Waiting for approval..." in output and b"[sudo/vouch] password for" in output:
        os.write(fd, fixture_password + b"\n")
        sent = True
    elif send_password == "empty" and not sent and b"[sudo/vouch] password for" in output:
        os.write(fd, b"\n")
        sent = True
    elif send_password == "wrong" and not sent and b"[sudo/vouch] password for" in output:
        os.write(fd, wrong_password + b"\n")
        sent = True
    elif send_password == "wrong-after" and not sent and b"[sudo/vouch] password for" in output:
        os.write(fd, wrong_password + b"\nleftover-input\n")
        sent = "wrong-sent"
    elif send_password in ("partial", "partial-after") and not sent and b"[sudo/vouch] password for" in output:
        os.write(fd, b"partial-input")
        sent = True
    elif send_password == "partial-after" and sent is True and b"after-sudo" in output:
        os.write(fd, b"after-input\n")
        sent = "after-sent"
    elif send_password == "wrong-after" and sent == "wrong-sent" and b"after-sudo" in output:
        os.write(fd, b"after-input\n")
        sent = "after-sent"
    elif send_password == "ctrl-c" and not sent and b"[sudo/vouch] password for" in output:
        os.write(fd, b"\x03")
        sent = True
    try:
        result = os.waitpid(pid, os.WNOHANG)
    except ChildProcessError:
        break
    if result[0] == pid:
        child_status = result[1]
        break
else:
    os.kill(pid, 15)
    raise SystemExit("PTY case timed out")

while True:
    ready, _, _ = select.select([fd], [], [], 0.1)
    if not ready:
        try:
            result = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            break
        if result[0] == pid:
            child_status = result[1]
            break
        continue
    try:
        chunk = os.read(fd, 4096)
    except OSError:
        break
    if not chunk:
        break
    output.extend(chunk)

if child_status is None:
    _, child_status = os.waitpid(pid, 0)
rc = os.waitstatus_to_exitcode(child_status)
sys.stdout.buffer.write(output)
print(f"PTY_RC={rc}")
print(f"PTY_ELAPSED_MS={int((time.monotonic() - started) * 1000)}")
if send_password in ("valid", "valid-progress", "empty", "wrong", "wrong-after", "partial", "partial-after", "ctrl-c") and b"[sudo/vouch] password for" not in output:
    raise SystemExit("password prompt was not observed")
normalized = bytes(output).replace(b"\r\n", b"\n")
if send_password == "valid-progress" and b"Waiting for approval...\n[sudo/vouch] password for" not in normalized:
    raise SystemExit("progress output did not redraw the password prompt")
if send_password == "background" and b"[sudo/vouch] password for" in output:
    raise SystemExit("background sudo opened the password prompt")
if send_password == "background" and time.monotonic() - started > 3:
    raise SystemExit("background sudo did not fail unavailable promptly")
if send_password == "partial-after" and b"read=after-input\n" not in normalized:
    raise SystemExit("terminal input was consumed after the sudo child returned")
if send_password == "partial-after" and b"partial-inputafter-input" in normalized:
    raise SystemExit("partial password remained in the tty input queue")
if send_password == "wrong-after":
    prompt = b"[sudo/vouch] password for"
    if output.count(prompt) != 1:
        raise SystemExit("password prompt was redrawn after the password branch completed")
    if b"read=after-input\n" not in normalized:
        raise SystemExit("shell did not receive its post-sudo input")
    if b"read=leftover-input\n" in normalized:
        raise SystemExit("leftover password input reached the shell")
PY
    local driver_status=$?
    set -e
    [ "$driver_status" -eq 0 ] || {
        scrub_secret || return 1
        echo "FAIL: PTY driver for $name" >&2
        sed -n '1,160p' "$output" >&2 || true
        return 1
    }
    case "$name" in
        approval-first|password-first|real-hook-password|hanging-hook|terminal-restore|progress-redraw|empty-password|background-no-prompt|closed-stderr)
            scrub_secret || return 1
            grep -Fq 'PTY_RC=0' "$output" || { echo "FAIL: $name did not approve" >&2; return 1; }
            ;;
        wrong-password|wrong-password-after-progress|explicit-deny|absent-transport|noninteractive|ctrl-c)
            scrub_secret || return 1
            grep -Fq 'PTY_RC=0' "$output" && { echo "FAIL: $name unexpectedly approved" >&2; return 1; }
            ;;
    esac
    if [ "$name" = noninteractive ]; then
        ! grep -Fq '[sudo/vouch] password for' "$output" || {
            echo 'FAIL: sudo -n reached the password tty' >&2
            return 1
        }
    fi
    if [ "$name" = wrong-password ]; then
        grep -Fq '[sudo/vouch] password rejected' "$output" || {
            echo 'FAIL: wrong password had no feedback' >&2
            return 1
        }
    fi
    echo "* PASS: $name"
}

run_case approval-first approved \
    'runuser -u fixture -- sudo /usr/bin/true; rc=$?; pid=$(cat /run/vouch-test/hook.pid); test ! -e /proc/$pid/status; exit $rc' none
run_case password-first delayed-unavailable \
    'runuser -u fixture -- sudo /usr/bin/true' valid
run_case wrong-password unavailable \
    'runuser -u fixture -- sudo /usr/bin/true' wrong
run_case wrong-password-after-progress post-password-progress \
    'runuser -u fixture -- /usr/local/bin/vouch-post-password-test' wrong-after
run_case explicit-deny denied \
    'runuser -u fixture -- sudo /usr/bin/true' none
run_case hanging-hook hanging \
    'runuser -u fixture -- sudo /usr/bin/true; rc=$?; pid=$(cat /run/vouch-test/hook.pid); test ! -e /proc/$pid/status; exit $rc' valid
run_case terminal-restore delayed-approved \
    'runuser -u fixture -- /usr/local/bin/vouch-terminal-restore-test' partial-after
run_case progress-redraw progress-unavailable \
    'runuser -u fixture -- sudo /usr/bin/true' valid-progress
run_case empty-password delayed-approved \
    'runuser -u fixture -- sudo /usr/bin/true' empty
run_case background-no-prompt unavailable \
    'set -m; trap "" INT; runuser -u fixture -- sudo /usr/bin/true & job=$!; wait "$job"; rc=$?; test "$rc" -ne 0; printf "background-rc=%s\\n" "$rc"; exit 0' background
run_case ctrl-c hanging \
    'trap "" INT; runuser -u fixture -- sudo /usr/bin/true; rc=$?; pid=$(cat /run/vouch-test/hook.pid); test ! -e /proc/$pid/status; tty_state=$(stty -a); case "$tty_state" in *-echo*) exit 1;; esac; printf "after-ctrl-c rc=%s\\n" "$rc"; exit 0' ctrl-c
run_case closed-stderr closed-stderr \
    'runuser -u fixture -- /usr/local/bin/vouch-closed-stderr-test' empty

# The real hook is exercised with a deliberately absent transport and sudo -n:
# status 2 is unavailable, and the plugin must fail closed without opening a
# password reader. This keeps the fake-hook race cases deterministic while
# still proving the actual hook/plugin/sudo integration path.
run_case real-hook-password real \
    'printf "NATS_URL=nats://127.0.0.1:1\\nVOUCH_ALLOW_PLAINTEXT_NATS=1\\n" >/etc/vouch/config.env; runuser -u fixture -- sudo /usr/bin/true' valid
run_case absent-transport real \
    'printf "VOUCH_AGENT_SOCKET=/run/vouch-test/missing.sock\\n" >/etc/vouch/config.env; runuser -u fixture -- sudo -n /usr/bin/true' none
run_case noninteractive unavailable \
    'runuser -u fixture -- sudo -n /usr/bin/true' none

TEST_SUCCEEDED=1
echo '* PASS: sudo password/approval race (Ubuntu 24.04, real sudo + PAM)'
