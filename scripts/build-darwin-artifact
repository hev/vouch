#!/usr/bin/env bash
set -euo pipefail

OUTPUT="${1:-}"
[ -n "$OUTPUT" ] || { echo "usage: build-darwin-artifact OUTPUT_DIR" >&2; exit 2; }
case "$OUTPUT" in /*) ;; *) OUTPUT="$(pwd -P)/$OUTPUT" ;; esac
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
REVISION="$(git -C "$ROOT" rev-parse HEAD)"
TARGET="aarch64-apple-darwin"
BUILD_ROOT="${CARGO_TARGET_DIR:-$ROOT/target}"
case "$BUILD_ROOT" in /*) ;; *) BUILD_ROOT="$ROOT/$BUILD_ROOT" ;; esac

cd "$ROOT"
# The agent links Security.framework and LocalAuthentication through
# vouch-enclave, so it builds here and nowhere else.
cargo build --locked --release --target "$TARGET" -p vouch-hook -p vouch-plugin -p vouch-agent -p vouch-server -p vouch-pam -p vouch-browser-relay
mkdir -p "$OUTPUT"
install -m 0755 "$BUILD_ROOT/$TARGET/release/vouch" "$OUTPUT/vouch"
install -m 0755 "$BUILD_ROOT/$TARGET/release/libvouch_plugin.dylib" "$OUTPUT/vouch.dylib"
# Homebrew rewrites LC_ID_DYLIB and re-signs any dylib in a keg whose id is
# not already the keg's opt path, which invalidates the checksum taken here
# (issue #87). Both dylibs are linked with that exact id by plugin/build.rs
# and pam/build.rs, so the fixup finds nothing to change and the bytes hashed
# below survive a bottle intact. Override VOUCH_PLUGIN_INSTALL_NAME /
# VOUCH_PAM_INSTALL_NAME to build for a non-default Homebrew prefix.
# Neither id is used at load time: sudo dlopens the plugin by the absolute
# path in sudo.conf and OpenPAM dlopens the module by the path in the auth
# line. The ad hoc signature is what the rest of the lane expects; a release
# lane signing with a Developer ID substitutes the identity here and adds
# --options runtime --timestamp, exactly as scripts/mac/bundle-agent does for
# the agent binary and its bundle, followed by `codesign --verify --strict`.
PLUGIN_INSTALL_NAME="${VOUCH_PLUGIN_INSTALL_NAME:-/opt/homebrew/opt/vouch/libexec/vouch.dylib}"
PAM_INSTALL_NAME="${VOUCH_PAM_INSTALL_NAME:-/opt/homebrew/opt/vouch/libexec/libvouch_pam.dylib}"
codesign --force --sign - "$OUTPUT/vouch.dylib"
# The PAM module keeps its own name here: install-vouch-hook looks the
# artifact up in SHA256SUMS under exactly libvouch_pam.dylib before it will
# install it, and the macOS auth line names the same file.
install -m 0644 "$BUILD_ROOT/$TARGET/release/libvouch_pam.dylib" "$OUTPUT/libvouch_pam.dylib"
codesign --force --sign - "$OUTPUT/libvouch_pam.dylib"
install -m 0755 "$BUILD_ROOT/$TARGET/release/vouch-agent" "$OUTPUT/vouch-agent"
install -m 0755 "$BUILD_ROOT/$TARGET/release/vouch-server" "$OUTPUT/vouch-server"
install -m 0755 "$BUILD_ROOT/$TARGET/release/vouch-browser-relay" "$OUTPUT/vouch-browser-relay"
codesign --force --sign - "$OUTPUT/vouch-browser-relay"
codesign --verify --strict "$OUTPUT/vouch-browser-relay"
# The Touch ID sheet takes its name and icon from the calling process's app
# bundle, so the agent a brew install runs has to live inside Vouch.app.
# The bundle is staged here, next to the flat binary, and both ship: a keg
# from an older release has no bundle and vouch-laptop-setup falls back to
# the flat one. bundle-agent copies the binary that was just built rather
# than building its own, so the two are the same build; the cmp below is the
# guard that keeps it that way.
CARGO_VERSION="$(sed -n '/^\[workspace\.package\]/,/^\[/s/^version = "\(.*\)"/\1/p' "$ROOT/Cargo.toml" | head -1)"
[ -n "$CARGO_VERSION" ] || { echo "cannot read the workspace version from $ROOT/Cargo.toml" >&2; exit 1; }
"$ROOT/scripts/mac/bundle-agent" --binary "$OUTPUT/vouch-agent" --output "$OUTPUT" \
  --version "$CARGO_VERSION" >/dev/null
APP_BIN="$OUTPUT/Vouch.app/Contents/MacOS/vouch-agent"
cmp -s "$OUTPUT/vouch-agent" "$APP_BIN" ||
  { echo "the bundled agent is not a copy of $OUTPUT/vouch-agent" >&2; exit 1; }
# An unsigned bundle fails `codesign --verify` outright ("code has no
# resources but signature indicates they must be present"), so the ad hoc
# signature is what makes the poured bundle verifiable. It seals
# Contents/_CodeSignature over the Info.plist and the icns and rewrites the
# main executable's own signature -- which is why the bundle copy no longer
# matches the flat binary byte for byte after this point and gets its own
# SHA256SUMS entry below rather than sharing the flat one.
codesign --force --sign - "$OUTPUT/Vouch.app"
codesign --verify --deep --strict "$OUTPUT/Vouch.app"
# Losing the icon is silent in bundle-agent (a machine with no renderer still
# gets a working bundle), but a release without it is the whole point missed.
[ -f "$OUTPUT/Vouch.app/Contents/Resources/Vouch.icns" ] ||
  { echo "Vouch.app has no icon: no SVG renderer on this builder" >&2; exit 1; }
# The bundle version is what Launch Services and crash reports show. It was a
# hardcoded 0.1.0 until 0.1.12; assert it tracks the release rather than
# trusting that it still does.
for key in CFBundleShortVersionString CFBundleVersion; do
  got="$(/usr/bin/plutil -extract "$key" raw -o - "$OUTPUT/Vouch.app/Contents/Info.plist")"
  [ "$got" = "$CARGO_VERSION" ] ||
    { echo "Vouch.app $key is $got, not the Cargo version $CARGO_VERSION" >&2; exit 1; }
done
install -m 0755 "$ROOT/scripts/install-vouch-hook" "$OUTPUT/install-vouch-hook"
install -m 0755 "$ROOT/scripts/vouch-laptop-setup" "$OUTPUT/vouch-laptop-setup"
install -m 0755 "$ROOT/scripts/vouch-phone-setup" "$OUTPUT/vouch-phone-setup"
install -m 0755 "$ROOT/scripts/vouch-google-login-setup" "$OUTPUT/vouch-google-login-setup"
install -m 0755 "$ROOT/scripts/vouch-browser-service" "$OUTPUT/vouch-browser-service"

mode_of() { if stat -f '%Lp' "$1" >/dev/null 2>&1; then stat -f '%Lp' "$1"; else stat -c '%a' "$1"; fi; }
hash_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi; }
hook_hash="$(hash_of "$OUTPUT/vouch")"
plugin_hash="$(hash_of "$OUTPUT/vouch.dylib")"
pam_hash="$(hash_of "$OUTPUT/libvouch_pam.dylib")"
relay_hash="$(hash_of "$OUTPUT/vouch-browser-relay")"
agent_hash="$(hash_of "$OUTPUT/vouch-agent")"
installer_hash="$(hash_of "$OUTPUT/install-vouch-hook")"
setup_hash="$(hash_of "$OUTPUT/vouch-laptop-setup")"
server_hash="$(hash_of "$OUTPUT/vouch-server")"
phone_setup_hash="$(hash_of "$OUTPUT/vouch-phone-setup")"
google_login_setup_hash="$(hash_of "$OUTPUT/vouch-google-login-setup")"
browser_service_hash="$(hash_of "$OUTPUT/vouch-browser-service")"
toolchain="$(rustc --version --verbose | tr '\n' ';')"
cat > "$OUTPUT/manifest.json" <<EOF
{"schema_version":1,"target":"$TARGET","revision":"$REVISION","toolchain":"$toolchain","files":[{"name":"vouch","mode":"$(mode_of "$OUTPUT/vouch")","sha256":"$hook_hash","media_type":"application/vnd.vouch.hook.v1"},{"name":"vouch.dylib","mode":"$(mode_of "$OUTPUT/vouch.dylib")","sha256":"$plugin_hash","media_type":"application/vnd.vouch.plugin.v1"},{"name":"libvouch_pam.dylib","mode":"$(mode_of "$OUTPUT/libvouch_pam.dylib")","sha256":"$pam_hash","media_type":"application/vnd.vouch.pam.v1"},{"name":"vouch-browser-relay","mode":"$(mode_of "$OUTPUT/vouch-browser-relay")","sha256":"$relay_hash","media_type":"application/vnd.oshioki.browser-relay.v1"},{"name":"vouch-agent","mode":"$(mode_of "$OUTPUT/vouch-agent")","sha256":"$agent_hash","media_type":"application/vnd.vouch.agent.v1"},{"name":"install-vouch-hook","mode":"$(mode_of "$OUTPUT/install-vouch-hook")","sha256":"$installer_hash","media_type":"application/vnd.vouch.installer.v1"},{"name":"vouch-laptop-setup","mode":"$(mode_of "$OUTPUT/vouch-laptop-setup")","sha256":"$setup_hash","media_type":"application/vnd.vouch.setup.v1"},{"name":"vouch-server","mode":"$(mode_of "$OUTPUT/vouch-server")","sha256":"$server_hash","media_type":"application/vnd.vouch.server.v1"},{"name":"vouch-phone-setup","mode":"$(mode_of "$OUTPUT/vouch-phone-setup")","sha256":"$phone_setup_hash","media_type":"application/vnd.vouch.phone-setup.v1"},{"name":"vouch-google-login-setup","mode":"$(mode_of "$OUTPUT/vouch-google-login-setup")","sha256":"$google_login_setup_hash","media_type":"application/vnd.vouch.google-login-setup.v1"},{"name":"vouch-browser-service","mode":"$(mode_of "$OUTPUT/vouch-browser-service")","sha256":"$browser_service_hash","media_type":"application/vnd.oshioki.browser-service.v1"}]}
EOF
# manifest.json stays a flat-file manifest: it is hashed into SHA256SUMS
# itself and the installer reads it by name, so the bundle entry goes only
# into SHA256SUMS, which is what vouch-laptop-setup verifies the bundle
# against before it will run it.
app_bin_rel="Vouch.app/Contents/MacOS/vouch-agent"
(
  cd "$OUTPUT"
  if command -v sha256sum >/dev/null 2>&1; then sha256sum vouch vouch.dylib libvouch_pam.dylib vouch-agent vouch-server vouch-browser-relay install-vouch-hook vouch-laptop-setup vouch-phone-setup vouch-google-login-setup vouch-browser-service manifest.json "$app_bin_rel" > SHA256SUMS; else shasum -a 256 vouch vouch.dylib libvouch_pam.dylib vouch-agent vouch-server vouch-browser-relay install-vouch-hook vouch-laptop-setup vouch-phone-setup vouch-google-login-setup vouch-browser-service manifest.json "$app_bin_rel" > SHA256SUMS; fi
)
for artifact in vouch vouch.dylib libvouch_pam.dylib vouch-agent vouch-server vouch-browser-relay \
  "Vouch.app/Contents/MacOS/vouch-agent"; do
  file "$OUTPUT/$artifact" | grep -q 'arm64'
done
nm -gU "$OUTPUT/vouch.dylib" | grep -Eq '(_)?approval_exec$'
# A PAM module with no pam_sm_authenticate is a module OpenPAM will load and
# then ignore.
nm -gU "$OUTPUT/libvouch_pam.dylib" | grep -Eq '(_)?pam_sm_authenticate$'
# The install names above are the whole of the fix for issue #87: if a build
# ever loses them, the next bottle silently goes back to failing checksum
# verification on the Mac, so assert them here rather than at install time.
[ "$(otool -D "$OUTPUT/vouch.dylib" | tail -1)" = "$PLUGIN_INSTALL_NAME" ]
[ "$(otool -D "$OUTPUT/libvouch_pam.dylib" | tail -1)" = "$PAM_INSTALL_NAME" ]
# The agent is useless without the enclave; a build that dropped the framework
# would still run and only fail at the first signature.
otool -L "$OUTPUT/vouch-agent" | grep -q 'LocalAuthentication'
otool -L "$OUTPUT/vouch-browser-relay" | grep -q 'LocalAuthentication'
